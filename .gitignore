# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Training checkpoints and cache
models/threat_bert/checkpoint-*/
models/threat_bert/checkpoint-epoch-*/
checkpoint-*/
.cache/
cache/

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# Temporary and OS files
.DS_Store
Thumbs.db
*.tmp
*.log

# Large uncompressed model files (Deploy with model_quantized.onnx.gz)
models/threat_bert/model.safetensors
models/threat_bert/model.onnx
models/threat_bert/model_quantized.onnx

# Allow compressed model and configs
!models/threat_bert/model_quantized.onnx.gz
!models/threat_bert/*.json
!models/threat_bert/*.txt
